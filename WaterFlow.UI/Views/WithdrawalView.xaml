<Page x:Class="WaterFlow.UI.Views.WithdrawalView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="صرف المنتجات" Loaded="Page_Loaded"
      Background="White">
    <Grid Padding="20">
        <StackPanel>
            <TextBlock Text="صرف منتجات من المستودع" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" x:Name="CbProduct" Padding="10" 
                          DisplayMemberPath="ProductName" Margin="0,0,10,0" Background="#ecf0f1" Opacity="0.9"/>
                <TextBox Grid.Column="1" x:Name="TxtQuantity" Padding="10" 
                         Margin="0,0,10,0" Foreground="#2C3E50" Background="#ecf0f1" Opacity="0.9"/>
                <Border Grid.Column="2" Background="#e74c3c" CornerRadius="3">
                    <Button Content="✓ صرف" Click="BtnWithdrawProduct_Click"
                            Background="Transparent" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </Border>
            </Grid>

            <TextBlock Text="ملاحظات (عميل، موقع، إلخ)" Margin="0,0,0,5" Foreground="#2C3E50" FontWeight="Bold"/>
            <TextBox x:Name="TxtNotes" Height="100" Padding="10" TextWrapping="Wrap" Margin="0,0,0,20"
                     Foreground="#2C3E50" Background="#ecf0f1" Opacity="0.9"/>

            <TextBlock Text="سجل العمليات" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#2C3E50"/>
            <DataGrid x:Name="TransactionsGrid" Height="300" Background="#ecf0f1" GridLinesVisibility="Horizontal"/>
        </StackPanel>
    </Grid>
</Page>
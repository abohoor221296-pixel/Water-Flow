<Page x:Class="WaterFlow.UI.Views.ProductsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="إدارة المنتجات" Loaded="Page_Loaded"
      Background="White">
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- نموذج الإضافة -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="إضافة منتج جديد" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2C3E50"/>
                
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtProductCode" Grid.Column="0" Padding="10" Margin="0,0,10,0" 
                             Foreground="#2C3E50" Background="#ecf0f1" Opacity="0.9"/>
                    <TextBox x:Name="TxtProductName" Grid.Column="1" Padding="10" Margin="0,0,10,0"
                             Foreground="#2C3E50" Background="#ecf0f1" Opacity="0.9"/>
                    <ComboBox x:Name="CbCategory" Grid.Column="2" Padding="10" Margin="0,0,10,0" 
                              DisplayMemberPath="CategoryName" Background="#ecf0f1" Opacity="0.9"/>
                    <Border Grid.Column="3" Background="#27ae60" CornerRadius="3">
                        <Button Content="إضافة" Click="BtnAddProduct_Click" 
                                Background="Transparent" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtQuantity" Grid.Column="0" Padding="10" Margin="0,0,10,0"
                             Foreground="#2C3E50" Background="#ecf0f1" Opacity="0.9"/>
                    <TextBox x:Name="TxtUnitPrice" Grid.Column="1" Padding="10" Margin="0,0,10,0"
                             Foreground="#2C3E50" Background="#ecf0f1" Opacity="0.9"/>
                    <TextBox x:Name="TxtUnit" Grid.Column="2" Padding="10" Margin="0,0,10,0"
                             Foreground="#2C3E50" Background="#ecf0f1" Opacity="0.9"/>
                    <TextBox x:Name="TxtMinimumStock" Grid.Column="3" Padding="10" Margin="0,0,10,0"
                             Foreground="#2C3E50" Background="#ecf0f1" Opacity="0.9"/>
                    <TextBox x:Name="TxtDescription" Grid.Column="4" Padding="10"
                             Foreground="#2C3E50" Background="#ecf0f1" Opacity="0.9"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- جدول المنتجات -->
        <DataGrid Grid.Row="1" x:Name="ProductsGrid" AutoGenerateColumns="True"
                  Background="#ecf0f1" GridLinesVisibility="Horizontal"/>
    </Grid>
</Page>
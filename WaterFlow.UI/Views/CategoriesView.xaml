<Page x:Class="WaterFlow.UI.Views.CategoriesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="إدارة التصنيفات" Loaded="Page_Loaded"
      Background="White">
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- نموذج الإضافة -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="إضافة تصنيف جديد" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2C3E50"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtCategoryName" Grid.Column="0" Padding="10" Margin="0,0,10,0"
                         Foreground="#2C3E50" Background="#ecf0f1" Opacity="0.9"/>
                <TextBox x:Name="TxtDescription" Grid.Column="1" Padding="10" Margin="0,0,10,0"
                         Foreground="#2C3E50" Background="#ecf0f1" Opacity="0.9"/>
                <Border Grid.Column="2" Background="#27ae60" CornerRadius="3" Padding="0">
                    <Button Content="إضافة" Click="BtnAddCategory_Click"
                            Background="Transparent" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </Border>
            </Grid>
        </StackPanel>

        <!-- جدول التصنيفات -->
        <DataGrid Grid.Row="1" x:Name="CategoriesGrid" AutoGenerateColumns="True"
                  Background="#ecf0f1" GridLinesVisibility="Horizontal"/>
    </Grid>
</Page>
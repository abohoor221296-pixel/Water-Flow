<Page x:Class="WaterFlow.UI.Views.AnalyticsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="التحاليل والإحصائيات" Loaded="Page_Loaded"
      Background="White">
    <Grid Padding="20">
        <StackPanel>
            <TextBlock Text="التحاليل والإحصائيات" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>
            
            <TabControl>
                <TabItem Header="الرسوم البيانية">
                    <Grid Background="#ecf0f1" Padding="20">
                        <TextBlock Text="الرسوم البيانية سيتم إضافتها قريباً" FontSize="14" Foreground="#7f8c8d"/>
                    </Grid>
                </TabItem>

                <TabItem Header="أفضل المنتجات">
                    <DataGrid x:Name="TopProductsGrid" Background="#ecf0f1" GridLinesVisibility="Horizontal"/>
                </TabItem>

                <TabItem Header="تحليل الصرف والإضافة">
                    <StackPanel Padding="20">
                        <TextBlock Text="إجمالي الصرف: " FontWeight="Bold" Margin="0,0,0,5" Foreground="#2C3E50"/>
                        <TextBlock x:Name="TxtTotalWithdrawals" Text="0" Margin="0,0,0,15" FontSize="16"/>
                        
                        <TextBlock Text="إجمالي الإضافة: " FontWeight="Bold" Margin="0,0,0,5" Foreground="#2C3E50"/>
                        <TextBlock x:Name="TxtTotalAdditions" Text="0" Margin="0,0,0,15" FontSize="16"/>

                        <TextBlock Text="صافي التغيير: " FontWeight="Bold" Margin="0,0,0,5" Foreground="#2C3E50"/>
                        <TextBlock x:Name="TxtNetChange" Text="0" Margin="0,0,0,15" FontSize="16"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Grid>
</Page>
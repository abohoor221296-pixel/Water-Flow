<Page x:Class="WaterFlow.UI.Views.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="لوحة التحكم" Loaded="Page_Loaded"
      Background="White">
    <Grid Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="لوحة التحكم" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>

                <!-- الإحصائيات -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- إجمالي المنتجات -->
                    <Border Grid.Column="0" Background="#3498db" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي المنتجات" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtTotalProducts" Text="0" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- المنتجات النشطة -->
                    <Border Grid.Column="1" Background="#2ecc71" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="المنتجات النشطة" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtActiveProducts" Text="0" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- التصنيفات -->
                    <Border Grid.Column="2" Background="#9b59b6" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="التصنيفات" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtTotalCategories" Text="0" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- قيمة المخزون -->
                    <Border Grid.Column="3" Background="#f39c12" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="قيمة المخزون" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtTotalValue" Text="$0" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- المخزون المنخفض -->
                    <Border Grid.Column="4" Background="#e74c3c" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="مخزون منخفض" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtLowStockProducts" Text="0" Foreground="White" FontSize="26" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- المنتجات ذات المخزون المنخفض -->
                <TextBlock Text="المنتجات ذات المخزون المنخفض" FontSize="16" FontWeight="Bold" Margin="0,20,0,10" Foreground="#2C3E50"/>
                <DataGrid x:Name="LowStockGrid" AutoGenerateColumns="True" Height="250" 
                          Background="#ecf0f1" GridLinesVisibility="Horizontal" Margin="0,0,0,20"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
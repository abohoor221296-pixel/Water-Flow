<Window x:Class="WaterFlow.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Water Flow - برنامج إدارة المستودع" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="#f5f5f5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- القائمة الجانبية -->
        <StackPanel Grid.Column="0" Background="#2C3E50" VerticalAlignment="Stretch">
            <TextBlock Text="Water Flow" Foreground="White" FontSize="18" FontWeight="Bold" 
                       Padding="10" TextAlignment="Center" Margin="0,20,0,20"/>

            <Button Content="📊 لوحة التحكم" Click="BtnDashboard_Click" 
                    Style="{StaticResource NavButtonStyle}" Height="50"/>
            <Button Content="🏷️ التصنيفات" Click="BtnCategories_Click" 
                    Style="{StaticResource NavButtonStyle}" Height="50"/>
            <Button Content="📦 المنتجات" Click="BtnProducts_Click" 
                    Style="{StaticResource NavButtonStyle}" Height="50"/>
            <Button Content="📥 الإضافة" Click="BtnAddition_Click" 
                    Style="{StaticResource NavButtonStyle}" Height="50"/>
            <Button Content="📤 الصرف" Click="BtnWithdrawal_Click" 
                    Style="{StaticResource NavButtonStyle}" Height="50"/>
            <Button Content="📈 التحاليل" Click="BtnAnalytics_Click" 
                    Style="{StaticResource NavButtonStyle}" Height="50"/>
            <Button Content="📄 التقارير" Click="BtnReports_Click" 
                    Style="{StaticResource NavButtonStyle}" Height="50"/>
            <Button Content="⚙️ الإعدادات" Click="BtnSettings_Click" 
                    Style="{StaticResource NavButtonStyle}" Height="50"/>

            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,20">
                <Button Content="🚪 خروج" Click="BtnExit_Click" 
                        Style="{StaticResource NavButtonStyle}" Height="50" Foreground="#e74c3c"/>
            </StackPanel>
        </StackPanel>

        <!-- محتوى الصفحة الرئيسية -->
        <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>